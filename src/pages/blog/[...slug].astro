---
import { render } from "astro:content"
import BlogLayout from "@/layouts/BlogLayout.astro"
import { getPosts, formatDate, readingTime } from "@/lib/blog"

// En un sitio estático Astro necesita saber de antemano qué páginas generar:
// getStaticPaths devuelve una ruta por artículo y, en build, se crea un
// dist/blog/<slug>/index.html para cada una.
export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<BlogLayout title={`${post.data.title} · Alba Mora de la Sen`} description={post.data.description}>
  <article class="mt-6">
    <a href="/blog" class="text-sm font-semibold text-slate-500! transition hover:text-slate-900! dark:text-slate-400! dark:hover:text-white!">
      ← Todos los artículos
    </a>
    <h1 class="mt-6 text-4xl! font-bold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {" · "}{readingTime(post.body)} min de lectura
    </p>
    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert prose-a:text-indigo-600! dark:prose-a:text-indigo-400! prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-xl">
      <Content />
    </div>
  </article>
</BlogLayout>
